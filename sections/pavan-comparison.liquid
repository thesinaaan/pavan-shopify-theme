{% comment %}
  Section 7: Product Comparison Table
  Pavan Steamed Puttu Podi vs Standard Store Brands with large green checks
{% endcomment %}

<div class="page-width sec-padding">
  <div style="text-align: center; margin-bottom: 40px;">
    <span class="eyebrow">{{ section.settings.subheading | escape }}</span>
    <h2 class="sec-title">{{ section.settings.heading | escape }}</h2>
    <p class="sec-desc">{{ section.settings.description | escape }}</p>
  </div>

  <div class="table-scroll-wrapper">
    <table class="pavan-comp-table">
      <thead>
        <tr style="background: #f8fafc;">
          <th style="padding: 16px 20px; text-align: left; font-family: var(--font-heading); font-size: 15px; font-weight: 700; border-bottom: 2px solid var(--border-color); width: 40%;">Feature / Quality</th>
          <th style="padding: 16px 20px; text-align: center; font-family: var(--font-heading); font-size: 16px; font-weight: 800; color: var(--primary); background: var(--primary-light); border-bottom: 2px solid var(--primary); width: 30%;">
            Pavan Steamed Puttu
          </th>
          <th style="padding: 16px 20px; text-align: center; font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--text-muted); border-bottom: 2px solid var(--border-color); width: 30%;">
            Standard Store Brands
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px; border-bottom: 1px solid #f1f5f9;">Grain Selection</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); border-bottom: 1px solid rgba(217,107,39,0.1); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> 100% Selected Raw Rice
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light); border-bottom: 1px solid #f1f5f9;">
            Mixed Commercial Grains
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px; border-bottom: 1px solid #f1f5f9;">Steam Processing</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); border-bottom: 1px solid rgba(217,107,39,0.1); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> Traditional Hygienic Steam
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light); border-bottom: 1px solid #f1f5f9;">
            Raw Unsteamed Milling
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px; border-bottom: 1px solid #f1f5f9;">Cooked Softness</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); border-bottom: 1px solid rgba(217,107,39,0.1); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> Extremely Soft & Fluffy
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light); border-bottom: 1px solid #f1f5f9;">
            Often Dry or Lumpy
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px; border-bottom: 1px solid #f1f5f9;">Steaming Time</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); border-bottom: 1px solid rgba(217,107,39,0.1); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> Fast 5 - 7 Mins
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light); border-bottom: 1px solid #f1f5f9;">
            12 - 15 Mins
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px; border-bottom: 1px solid #f1f5f9;">Chemical Preservatives</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); border-bottom: 1px solid rgba(217,107,39,0.1); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> Zero Added Chemicals
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light); border-bottom: 1px solid #f1f5f9;">
            May Contain Bleaches
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 20px; font-weight: 600; font-size: 14px;">Airtight Fresh Foil Packaging</td>
          <td style="padding: 14px 20px; text-align: center; background: var(--primary-light); font-weight: 700; color: var(--secondary);">
            <span style="display: inline-block; background: #dcfce7; color: #15803d; border-radius: 50%; width: 24px; height: 24px; line-height: 24px; font-size: 13px; margin-right: 4px;">✓</span> Moisture Barrier Foil
          </td>
          <td style="padding: 14px 20px; text-align: center; color: var(--text-light);">
            Standard Plastic Pouch
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Product Comparison",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "THE UNMATCHED STANDARD" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pavan vs Standard Store Brands" },
    { "type": "text", "id": "description", "label": "Description", "default": "See why Kerala families choose Pavan for their daily authentic breakfast." }
  ],
  "presets": [
    { "name": "Product Comparison" }
  ]
}
{% endschema %}
