{% comment %}
  Section: Sticky Add to Cart Bar on Scroll
  Appears at bottom of screen on both Desktop & Mobile when user scrolls down
{% endcomment %}

{% assign pavan_prod = section.settings.product | default: product | default: collections.all.products.first %}
{% assign current_variant = pavan_prod.selected_or_first_available_variant | default: pavan_prod.variants.first %}

<div id="PavanStickyBar" class="pavan-sticky-bar">
  <div class="pavan-sticky-container">
    <div class="pavan-sticky-product-info">
      <img src="{{ current_variant.featured_media | default: pavan_prod.featured_media | image_url: width: 100 }}" alt="{{ pavan_prod.title | escape }}" width="44" height="44" class="pavan-sticky-thumb">
      <div class="pavan-sticky-text-wrap">
        <div class="pavan-sticky-title">{{ pavan_prod.title | escape }}</div>
        <div class="pavan-sticky-meta">
          {% assign sticky_price_fmt = current_variant.price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
          {% assign sticky_cmp_fmt = current_variant.compare_at_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
          <span class="pavan-sticky-price" id="StickyBarPrice">{{ sticky_price_fmt }}</span>
          <span class="pavan-sticky-mrp">{% if current_variant.compare_at_price > current_variant.price %}{{ sticky_cmp_fmt }}{% endif %}</span>
        </div>
      </div>
    </div>
    
    <div class="pavan-sticky-action">
      <button type="button" class="pavan-sticky-btn" id="StickyAddToCartBtn" onclick="pavanAddToCart();">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <span id="StickyAddToCartBtnText">ADD TO CART</span>
      </button>
    </div>
  </div>
</div>

<style>
  .pavan-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #ffffff;
    border-top: 1px solid var(--border-color, #e5e7eb);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.12);
    padding: 10px 16px;
    transform: translateY(110%);
    transition: transform 0.3s ease;
  }
  .pavan-sticky-bar.is-visible, .pavan-sticky-bar.visible {
    transform: translateY(0) !important;
  }
  .pavan-sticky-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pavan-sticky-product-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }
  .pavan-sticky-thumb {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 8px;
    background: #fff9f0;
    padding: 2px;
    border: 1px solid #e5e7eb;
    flex-shrink: 0;
  }
  .pavan-sticky-text-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
  }
  .pavan-sticky-title {
    font-weight: 700;
    font-size: 14px;
    color: #18181b;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pavan-sticky-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    white-space: nowrap;
  }
  .pavan-sticky-stars {
    color: #f59e0b;
    font-size: 11px;
    flex-shrink: 0;
  }
  .pavan-sticky-price {
    font-weight: 800;
    font-size: 15px;
    color: #d96b27;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pavan-sticky-mrp {
    font-size: 12px;
    color: #9ca3af;
    text-decoration: line-through;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .pavan-sticky-action {
    flex-shrink: 0;
  }
  .pavan-sticky-btn {
    background: #d96b27;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(217, 107, 39, 0.3);
    transition: background 0.2s ease, transform 0.1s ease;
  }
  .pavan-sticky-btn:hover {
    background: #b85418;
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .pavan-sticky-bar {
      padding: 8px 12px;
    }
    .pavan-sticky-title {
      font-size: 13px;
    }
    .pavan-sticky-price {
      font-size: 13px;
    }
    .pavan-sticky-btn {
      padding: 8px 14px;
      font-size: 12px;
      height: 38px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var stickyBar = document.getElementById('PavanStickyBar');
    if (!stickyBar) return;

    window.addEventListener('scroll', function() {
      var scrollPosition = window.scrollY || document.documentElement.scrollTop;
      if (scrollPosition > 350) {
        stickyBar.classList.add('is-visible');
      } else {
        stickyBar.classList.remove('is-visible');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Sticky Add To Cart Bar",
  "settings": [],
  "presets": [
    { "name": "Sticky Add To Cart Bar" }
  ]
}
{% endschema %}
