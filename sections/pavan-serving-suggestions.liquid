{% comment %}
  Section 5: Serving Suggestions
  Luxury food pairing showcase featuring traditional Kerala breakfast accompaniments
{% endcomment %}

<div class="page-width sec-padding">
  <div style="text-align: center; margin-bottom: 40px;">
    <span class="eyebrow">{{ section.settings.subheading | escape }}</span>
    <h2 class="sec-title">{{ section.settings.heading | escape }}</h2>
    <p class="sec-desc">{{ section.settings.description | escape }}</p>
  </div>

  <div class="pavan-grid-5">
    {% for block in section.blocks %}
      {% assign card_img = '' %}
      {% if block.settings.image != blank %}
        {% assign card_img = block.settings.image | image_url: width: 400 %}
      {% elsif block.settings.image_filename != blank %}
        {% assign card_img = block.settings.image_filename | asset_url %}
      {% else %}
        {% assign lower_title = block.settings.title | downcase %}
        {% if lower_title contains 'kadala' %}
          {% assign card_img = 'serving-kadala-curry.png' | asset_url %}
        {% elsif lower_title contains 'nendran' or lower_title contains 'banana' or lower_title contains 'plantain' %}
          {% assign card_img = 'serving-steamed-nendran.png' | asset_url %}
        {% elsif lower_title contains 'ghee' %}
          {% assign card_img = 'serving-pure-cow-ghee.png' | asset_url %}
        {% elsif lower_title contains 'stew' or lower_title contains 'veg' or lower_title contains 'coconut' %}
          {% assign card_img = 'serving-veg-stew.png' | asset_url %}
        {% elsif lower_title contains 'egg' or lower_title contains 'roast' %}
          {% assign card_img = 'serving-egg-roast.png' | asset_url %}
        {% else %}
          {% case forloop.index %}
            {% when 1 %}
              {% assign card_img = 'serving-kadala-curry.png' | asset_url %}
            {% when 2 %}
              {% assign card_img = 'serving-steamed-nendran.png' | asset_url %}
            {% when 3 %}
              {% assign card_img = 'serving-pure-cow-ghee.png' | asset_url %}
            {% when 4 %}
              {% assign card_img = 'serving-veg-stew.png' | asset_url %}
            {% when 5 %}
              {% assign card_img = 'serving-egg-roast.png' | asset_url %}
          {% endcase %}
        {% endif %}
      {% endif %}

      {% assign card_title = block.settings.title %}
      {% assign card_desc = block.settings.description %}
      {% if card_title == "Fresh Coconut" %}
        {% assign card_title = "Puttu + Vegetable Stew" %}
        {% assign card_desc = "Mild aromatic coconut milk gravy with garden veggies." %}
      {% endif %}

      <div class="serving-card" {{ block.shopify_attributes }} style="background: var(--accent-cream); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 14px; text-align: center; box-shadow: var(--shadow-subtle); display: flex; flex-direction: column; align-items: center;">
        <div style="width: 100%; aspect-ratio: 1 / 1; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 12px; background: #fff; border: 1px solid rgba(0,0,0,0.06); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          {% if card_img != blank %}
            <img src="{{ card_img }}" alt="{{ card_title | escape }}" loading="lazy" width="300" height="300" style="width: 100%; height: 100%; object-fit: cover; cursor: pointer; display: block;" onclick="openPavanLightbox('{{ card_img }}', '{{ card_title | escape }}')">
          {% else %}
            <div style="font-size: 32px; display: flex; align-items: center; justify-content: center; height: 100%;">{{ block.settings.icon }}</div>
          {% endif %}
        </div>
        <h3 style="font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--text-main); margin: 0 0 4px; line-height: 1.3;">{{ card_title | escape }}</h3>
        <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4; margin: 0;">{{ card_desc | escape }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Serving Suggestions",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "AUTHENTIC PAIRINGS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Traditional Kerala Serving Ideas" },
    { "type": "text", "id": "description", "label": "Description", "default": "Elevate your morning table with these timeless Kerala pairings." }
  ],
  "blocks": [
    {
      "type": "pairing",
      "name": "Pairing Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_filename", "label": "Asset Image Filename (Fallback)" },
        { "type": "text", "id": "icon", "label": "Emoji / Icon (Fallback)", "default": "🍛" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kadala Curry" },
        { "type": "text", "id": "description", "label": "Description", "default": "Spiced black chickpea gravy with toasted coconut." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Serving Suggestions",
      "blocks": [
        { "type": "pairing", "settings": { "image_filename": "serving-kadala-curry.png", "title": "Puttu with Kadala Curry", "description": "Classic roasted coconut black chickpea curry." } },
        { "type": "pairing", "settings": { "image_filename": "serving-steamed-nendran.png", "title": "Steamed Nendran", "description": "Sweet ripe Kerala plantain & fine sugar." } },
        { "type": "pairing", "settings": { "image_filename": "serving-pure-cow-ghee.png", "title": "Pure Cow Ghee", "description": "Golden melted ghee drizzled over hot puttu." } },
        { "type": "pairing", "settings": { "image_filename": "serving-veg-stew.png", "title": "Puttu + Vegetable Stew", "description": "Mild aromatic coconut milk gravy with garden veggies." } },
        { "type": "pairing", "settings": { "image_filename": "serving-egg-roast.png", "title": "Kerala Egg Roast", "description": "Rich caramelized onion & egg gravy." } }
      ]
    }
  ]
}
{% endschema %}
