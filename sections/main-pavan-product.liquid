{% comment %}
  Main Product Section
  Shopify Online Store 2.0 section for product display, variant selection, and Ajax add-to-cart.
{% endcomment %}

{% assign pavan_prod = section.settings.product | default: product | default: collections.all.products.first %}
{% assign current_variant = pavan_prod.selected_or_first_available_variant | default: pavan_prod.variants.first %}

<div class="page-width sec-padding" id="PavanHeroSection">
  <div class="hero-grid">
    <!-- Left Column: Product Gallery -->
    <div class="hero-gallery-wrap">
      <div class="hero-main-img-box">
        <div class="hero-badges-header">
          {% if section.settings.show_badge and section.settings.badge_text != blank %}
            <span class="badge-tag">{{ section.settings.badge_text | escape }}</span>
          {% else %}
            <span></span>
          {% endif %}
          {% if section.settings.cert_text != blank %}
            <span class="cert-tag">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              {{ section.settings.cert_text | escape }}
            </span>
          {% endif %}
        </div>

        {% assign featured_media = current_variant.featured_media | default: pavan_prod.featured_media %}
        {% if featured_media != blank %}
          <img 
            id="MainProductImage"
            src="{{ featured_media | image_url: width: 800 }}" 
            alt="{{ featured_media.alt | default: pavan_prod.title | escape }}" 
            width="800" 
            height="800" 
            loading="eager"
            onclick="openPavanLightbox(this.src, '{{ pavan_prod.title | escape }}')"
            style="cursor: zoom-in;">
        {% else %}
          <div style="background: #f4f4f5; display: flex; align-items: center; justify-content: center; height: 350px; width: 100%; border-radius: var(--radius-md);">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <!-- Gallery Thumbnails -->
      {% if pavan_prod.media.size > 1 %}
        <div class="product-thumbnails" style="display: flex; gap: 12px; margin-top: 16px; justify-content: center;">
          {% for media in pavan_prod.media %}
            <button type="button" class="thumb-btn {% if forloop.first %}active{% endif %}" onclick="document.getElementById('MainProductImage').src='{{ media | image_url: width: 800 }}'; this.parentElement.querySelectorAll('button').forEach(b => b.style.borderColor='var(--border-color)'); this.style.borderColor='var(--primary)';" style="border: 2px solid {% if forloop.first %}var(--primary){% else %}var(--border-color){% endif %}; border-radius: var(--radius-sm); overflow: hidden; background: white; cursor: pointer; padding: 2px; width: 74px; height: 74px;" aria-label="Thumbnail {{ forloop.index }}">
              <img src="{{ media | image_url: width: 140 }}" alt="{{ media.alt | default: pavan_prod.title | escape }}" width="70" height="70" style="object-fit: contain; display: block;">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Product Info & Dynamic Blocks -->
    <div class="hero-details-wrap">
      {% render 'pavan-star-rating' %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'vendor' %}
            {% if pavan_prod.vendor != blank %}
              <div class="product-block-item" {{ block.shopify_attributes }} style="margin-top: 8px;">
                <span style="font-size: 11px; font-weight: 700; color: var(--secondary); letter-spacing: 1.5px; text-transform: uppercase;">{{ pavan_prod.vendor | escape }}</span>
              </div>
            {% endif %}

          {% when 'title' %}
            <div class="product-block-item" {{ block.shopify_attributes }}>
              <h1 class="hero-title">
                {% if block.settings.title_text != blank %}
                  {{ block.settings.title_text | escape }}
                {% else %}
                  {{ pavan_prod.title | escape }}
                {% endif %}
              </h1>
            </div>

          {% when 'subtitle' %}
            {% if block.settings.text != blank %}
              <div class="product-block-item" {{ block.shopify_attributes }}>
                <p class="malayalam-subtitle">{{ block.settings.text | escape }}</p>
              </div>
            {% endif %}

          {% when 'price' %}
            <div class="product-block-item" {{ block.shopify_attributes }}>
              <div class="price-card">
                {% assign curr_price_fmt = current_variant.price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
                <span class="curr-price" id="ProductPrice">{{ curr_price_fmt }}</span>
                {% if current_variant.compare_at_price > current_variant.price %}
                  {% assign mrp_price_fmt = current_variant.compare_at_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
                  <span class="mrp-price" id="MrpPrice">{{ mrp_price_fmt }}</span>
                  <span class="save-badge">SAVE {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}%</span>
                {% endif %}
              </div>
            </div>

          {% when 'variant_picker' %}
            {% if pavan_prod.has_only_default_variant == false or pavan_prod.variants.size > 1 %}
              <div class="product-block-item" {{ block.shopify_attributes }}>
                <label style="display: block; font-weight: 700; font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 8px; color: var(--text-main);">Select Variant:</label>
                <div class="variant-selector-grid" id="PavanVariantPicker">
                  {% for variant in pavan_prod.variants %}
                    {% assign v_price_fmt = variant.price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
                    {% assign v_cmp_fmt = variant.compare_at_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
                    <div class="v-card-box {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled-variant{% endunless %}"
                         data-variant-id="{{ variant.id }}"
                         data-price="{{ v_price_fmt }}"
                         data-compare-at-price="{% if variant.compare_at_price > variant.price %}{{ v_cmp_fmt }}{% endif %}"
                         data-available="{% if variant.available %}true{% else %}false{% endif %}"
                         onclick="selectProductVariant(this);">
                      <strong>{{ variant.title | escape }}</strong><br>
                      <span style="font-size: 13px; color: var(--primary); font-weight: 700;">{{ v_price_fmt }}</span>
                    </div>
                  {% endfor %}
                </div>
                <input type="hidden" id="SelectedVariantId" name="id" value="{{ current_variant.id }}">
              </div>
            {% else %}
              <input type="hidden" id="SelectedVariantId" name="id" value="{{ current_variant.id }}">
            {% endif %}

          {% when 'quantity' %}
            <div class="product-block-item" {{ block.shopify_attributes }} style="margin: 16px 0;">
              <label style="display: block; font-weight: 700; font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 6px; color: var(--text-main);">Quantity:</label>
              <div style="display: flex; align-items: center; border: 1.5px solid var(--border-color); border-radius: var(--radius-sm); width: fit-content; background: white; overflow: hidden;">
                <button type="button" onclick="var q=document.getElementById('HeroQty'); if(parseInt(q.value)>1) q.value=parseInt(q.value)-1;" style="border: none; background: #f4f4f5; width: 40px; height: 40px; font-size: 18px; font-weight: bold; cursor: pointer;">-</button>
                <input type="number" id="HeroQty" value="1" min="1" readonly style="width: 50px; height: 40px; border: none; text-align: center; font-weight: 700; font-size: 15px;">
                <button type="button" onclick="var q=document.getElementById('HeroQty'); q.value=parseInt(q.value)+1;" style="border: none; background: #f4f4f5; width: 40px; height: 40px; font-size: 18px; font-weight: bold; cursor: pointer;">+</button>
              </div>
            </div>

          {% when 'buy_buttons' %}
            <div class="product-block-item" {{ block.shopify_attributes }}>
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <button type="button" class="btn-add-cart" id="HeroAddToCartBtn" onclick="pavanAddToCart();">
                  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                  <span id="HeroAddToCartBtnText">{{ block.settings.button_label | default: "ADD TO CART" | escape }}</span>
                </button>
                <button type="button" id="HeroBuyNowBtn" onclick="pavanAddToCart();" style="width: 100%; height: 50px; background: var(--secondary); color: white; font-weight: 700; font-size: 15px; border: none; border-radius: var(--radius-md); cursor: pointer; transition: background 0.2s;">
                  BUY IT NOW
                </button>
              </div>
            </div>

          {% when 'delivery' %}
            <div class="product-block-item" {{ block.shopify_attributes }} style="margin-top: 16px;">
              <p style="font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 8px; margin: 0; background: var(--accent-cream); padding: 12px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
                <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                <span>{{ block.settings.text | default: "Estimated Delivery: 2-4 Days | Ships Fresh from Aluva, Kerala" | escape }}</span>
              </p>
            </div>

          {% when 'trust_row' %}
            <div class="product-block-item" {{ block.shopify_attributes }}>
              {% render 'pavan-trust-badges' %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pavan Main Product Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product Override" },
    { "type": "checkbox", "id": "show_badge", "label": "Show Badge Tag", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge Text", "default": "BESTSELLER" },
    { "type": "text", "id": "cert_text", "label": "Certification Text", "default": "FSSAI REGISTERED" }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor Subtitle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "PAVAN AGRO FOODS • ALUVA, KERALA" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title_text", "label": "Title Override" }
      ]
    },
    {
      "type": "subtitle",
      "name": "Malayalam Subtitle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Subtitle", "default": "പാകത്തിൽ സ്റ്റീം ചെയ്ത പ്രീമിയം പുട്ടുപൊടി" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "mrp_price", "label": "MRP Price", "default": "₹99.00" }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "v1", "label": "Variant 1", "default": "1 Kg Pack" },
        { "type": "text", "id": "v2", "label": "Variant 2", "default": "2 Kg Pack" },
        { "type": "text", "id": "v3", "label": "Variant 3", "default": "5 Kg Family" }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity Selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "ADD TO CART" }
      ]
    },
    {
      "type": "delivery",
      "name": "Delivery Info",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Delivery Microcopy", "default": "Estimated Delivery: 2-4 Days | Ships Fresh from Aluva, Kerala" }
      ]
    },
    {
      "type": "trust_row",
      "name": "Trust Badges Row",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Pavan Main Product Hero",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "subtitle" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity" },
        { "type": "buy_buttons" },
        { "type": "delivery" },
        { "type": "trust_row" }
      ]
    }
  ]
}
{% endschema %}
