{% comment %}
  Section 2: Why Choose Pavan
  Incorporates the official "MADE FOR EVERYDAY COOKING" feature banner asset
{% endcomment %}

<div class="page-width sec-padding" id="PavanWhyChooseSection">
  <div style="text-align: center; margin-bottom: 40px;">
    <span class="eyebrow">{{ section.settings.subheading | escape }}</span>
    <h2 class="sec-title">{{ section.settings.heading | escape }}</h2>
    <p class="sec-desc">{{ section.settings.description | escape }}</p>
  </div>

  <div class="pavan-grid-2">
    <!-- Official Feature Banner Image Asset -->
    <div class="real-banner-box">
      <img 
        src="{{ 'pavan-why-stands-out.png' | asset_url }}" 
        alt="{{ product.title | escape }} - Features Comparison" 
        width="600" 
        height="400" 
        loading="lazy" 
        onclick="openPavanLightbox('{{ 'pavan-why-stands-out.png' | asset_url }}', '{{ product.title | escape }} Features Comparison')">
      <p style="font-size: 13px; color: var(--text-light); margin-top: 10px; margin-bottom: 0;">Tap image to view high-resolution features infograph.</p>
    </div>

    <!-- Feature Callout Cards -->
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-subtle); display: flex; gap: 14px; align-items: flex-start;">
        <div style="background: var(--primary-light); color: var(--primary); font-size: 18px; font-weight: bold; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">🔥</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; margin: 0 0 4px;">Roasted to the Right Level</h3>
          <p style="font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.5;">Steam-roasted under controlled temperature so grains absorb water uniformly without forming lumps or sticky dough.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-subtle); display: flex; gap: 14px; align-items: flex-start;">
        <div style="background: var(--secondary-light); color: var(--secondary); font-size: 18px; font-weight: bold; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">🥣</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; margin: 0 0 4px;">Ready to Cook Instant Ease</h3>
          <p style="font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.5;">No extra roasting or complex preparation needed. Just moisten with water & salt and steam for 5–7 minutes.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-subtle); display: flex; gap: 14px; align-items: flex-start;">
        <div style="background: var(--primary-light); color: var(--primary); font-size: 18px; font-weight: bold; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">🔬</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; margin: 0 0 4px;">Batch-Wise Lab Tested</h3>
          <p style="font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.5;">Every single batch undergoes laboratory analysis for moisture lock, fine texture, and zero chemical adulteration.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-subtle); display: flex; gap: 14px; align-items: flex-start;">
        <div style="background: var(--secondary-light); color: var(--secondary); font-size: 18px; font-weight: bold; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">🛡️</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; margin: 0 0 4px;">Hygienically Processed</h3>
          <p style="font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.5;">Milled in an automated, touchless facility in Aluva, Kerala following ISO 22000:2018 food safety standards.</p>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Choose Pavan",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "AUTHENTIC ADVANTAGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for Everyday Kerala Cooking" },
    { "type": "text", "id": "description", "label": "Description", "default": "Crafted with traditional steam-milling secrets so every breakfast is soft, fluffy, and wholesome." }
  ],
  "presets": [
    { "name": "Why Choose Pavan" }
  ]
}
{% endschema %}
