{% comment %}
  Pavan Cart Page Section
  Shopify Online Store 2.0 section rendering the /cart page with dynamic line items, subtotal, and checkout form.
{% endcomment %}

<div class="page-width sec-padding" id="PavanCartSection">
  {% if cart.item_count > 0 %}
    <div class="cart-header-wrap">
      <h1 class="cart-title">Your Shopping Cart</h1>
      <span class="cart-count-badge">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-form-grid">
      <!-- Left Column: Cart Items -->
      <div class="cart-items-list">
        <div class="cart-table-header">
          <span>Product</span>
          <span>Price</span>
          <span>Quantity</span>
          <span style="text-align: right;">Total</span>
        </div>

        {% for item in cart.items %}
          {% assign item_price_fmt = item.final_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
          {% assign line_price_fmt = item.final_line_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
          
          <div class="cart-item-row" data-line-index="{{ forloop.index }}">
            <!-- Image -->
            <div class="cart-item-media">
              <a href="{{ item.url }}">
                {% if item.image != blank %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="90" height="90" loading="lazy">
                {% else %}
                  <div class="cart-img-placeholder">
                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                  </div>
                {% endif %}
              </a>
            </div>

            <!-- Details -->
            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title | escape }}</a>
              
              {% unless item.product.has_only_default_variant %}
                <div class="cart-item-variant">{{ item.variant.title | escape }}</div>
              {% endunless %}

              {% if item.vendor != blank %}
                <div class="cart-item-vendor">{{ item.vendor | escape }}</div>
              {% endif %}

              <a href="{{ item.url_to_remove }}" class="cart-remove-link">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                Remove
              </a>
            </div>

            <!-- Unit Price -->
            <div class="cart-item-price">
              <span class="price-val">{{ item_price_fmt }}</span>
            </div>

            <!-- Quantity -->
            <div class="cart-item-qty">
              <div class="qty-control-box">
                <button type="button" class="qty-btn" onclick="var q=this.parentElement.querySelector('input'); if(parseInt(q.value)>1) { q.value=parseInt(q.value)-1; this.form.submit(); }">-</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" id="updates_{{ item.key }}" class="qty-input" onchange="this.form.submit();">
                <button type="button" class="qty-btn" onclick="var q=this.parentElement.querySelector('input'); q.value=parseInt(q.value)+1; this.form.submit();">+</button>
              </div>
            </div>

            <!-- Line Total -->
            <div class="cart-item-total">
              <span class="total-val">{{ line_price_fmt }}</span>
            </div>
          </div>
        {% endfor %}

        <div class="cart-actions-row">
          <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btn-continue-shopping">
            ← Continue Shopping
          </a>
          <button type="submit" name="update" class="btn-update-cart">
            Update Cart
          </button>
        </div>
      </div>

      <!-- Right Column: Order Summary -->
      <div class="cart-summary-card">
        <h2 class="summary-title">Order Summary</h2>

        <div class="summary-line">
          <span>Subtotal</span>
          {% assign cart_total_fmt = cart.total_price | money | replace: 'Rs.', '₹' | replace: 'Rs', '₹' %}
          <span class="subtotal-val">{{ cart_total_fmt }}</span>
        </div>

        <p class="shipping-notice">
          Taxes and shipping calculated at checkout. Free shipping on orders over ₹499.
        </p>

        <button type="submit" name="checkout" class="btn-checkout">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          PROCEED TO CHECKOUT
        </button>

        <div class="cart-trust-badges">
          <div class="trust-badge-item">
            <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>100% Safe & Secure Checkout</span>
          </div>
          <div class="trust-badge-item">
            <svg width="18" height="18" fill="none" stroke="var(--primary)" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
            <span>Freshly Packed in Aluva, Kerala</span>
          </div>
        </div>
      </div>
    </form>

  {% else %}
    <!-- Empty Cart State -->
    <div class="cart-empty-box">
      <div class="empty-icon-wrap">
        <svg width="64" height="64" fill="none" stroke="var(--primary)" stroke-width="1.5" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
      </div>
      <h2 class="empty-heading">Your cart is currently empty</h2>
      <p class="empty-subtext">Explore our range of authentic Kerala steamed puttu podi and daily food staples.</p>
      <a href="{{ routes.all_products_collection_url | default: routes.root_url }}" class="btn-start-shopping">
        START SHOPPING
      </a>
    </div>
  {% endif %}
</div>

<style>
  .cart-header-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .cart-title {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0;
  }
  .cart-count-badge {
    background: var(--accent-cream);
    color: var(--primary);
    border: 1px solid var(--border-color);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
  }
  .cart-form-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 32px;
    align-items: start;
  }
  .cart-items-list {
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .cart-table-header {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1fr;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--border-color);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-light);
  }
  .cart-item-row {
    display: grid;
    grid-template-columns: 80px 2fr 1fr 1.2fr 1fr;
    gap: 16px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .cart-item-media img {
    border-radius: var(--radius-sm);
    object-fit: contain;
    background: var(--accent-cream);
    border: 1px solid var(--border-color);
  }
  .cart-img-placeholder {
    width: 80px;
    height: 80px;
    background: #f4f4f5;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #a1a1aa;
  }
  .cart-item-title {
    font-weight: 700;
    font-size: 15px;
    color: var(--text-main);
    text-decoration: none;
    display: block;
    line-height: 1.3;
  }
  .cart-item-title:hover {
    color: var(--primary);
  }
  .cart-item-variant {
    font-size: 13px;
    color: var(--primary);
    font-weight: 600;
    margin-top: 4px;
  }
  .cart-item-vendor {
    font-size: 11px;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 2px;
  }
  .cart-remove-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #ef4444;
    text-decoration: none;
    margin-top: 8px;
    font-weight: 600;
  }
  .cart-remove-link:hover {
    text-decoration: underline;
  }
  .cart-item-price .price-val {
    font-weight: 600;
    font-size: 15px;
    color: var(--text-main);
  }
  .qty-control-box {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius-sm);
    width: fit-content;
    background: white;
    overflow: hidden;
  }
  .qty-btn {
    border: none;
    background: #f4f4f5;
    width: 32px;
    height: 34px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    color: var(--text-main);
  }
  .qty-btn:hover {
    background: #e4e4e7;
  }
  .qty-input {
    width: 40px;
    height: 34px;
    border: none;
    text-align: center;
    font-weight: 700;
    font-size: 14px;
  }
  .cart-item-total {
    text-align: right;
  }
  .cart-item-total .total-val {
    font-weight: 800;
    font-size: 16px;
    color: var(--primary);
  }
  .cart-actions-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 16px;
  }
  .btn-continue-shopping {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .btn-continue-shopping:hover {
    color: var(--primary);
  }
  .btn-update-cart {
    background: white;
    border: 1.5px solid var(--border-color);
    color: var(--text-main);
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .btn-update-cart:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .cart-summary-card {
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    position: sticky;
    top: 90px;
  }
  .summary-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 20px;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--border-color);
  }
  .summary-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 16px;
  }
  .subtotal-val {
    font-size: 22px;
    font-weight: 800;
    color: var(--primary);
  }
  .shipping-notice {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 24px;
    background: var(--accent-cream);
    padding: 12px;
    border-radius: var(--radius-sm);
  }
  .btn-checkout {
    width: 100%;
    height: 52px;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s, transform 0.1s;
    box-shadow: 0 4px 16px rgba(217, 107, 39, 0.25);
  }
  .btn-checkout:hover {
    background: var(--primary-dark);
  }
  .cart-trust-badges {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--border-color);
  }
  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .cart-empty-box {
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 60px 24px;
    text-align: center;
    max-width: 540px;
    margin: 40px auto;
  }
  .empty-icon-wrap {
    width: 96px;
    height: 96px;
    background: var(--accent-cream);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }
  .empty-heading {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 10px;
  }
  .empty-subtext {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0 0 24px;
  }
  .btn-start-shopping {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 14px 32px;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 14px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(217, 107, 39, 0.25);
  }
  .btn-start-shopping:hover {
    background: var(--primary-dark);
  }

  @media (max-width: 992px) {
    .cart-form-grid {
      grid-template-columns: 1fr;
    }
    .cart-table-header {
      display: none;
    }
    .cart-item-row {
      grid-template-columns: 70px 1fr;
      grid-template-areas:
        "img info"
        "img price"
        "qty total";
      gap: 12px;
      padding: 16px 0;
    }
    .cart-item-media { grid-area: img; }
    .cart-item-info { grid-area: info; }
    .cart-item-price { grid-area: price; }
    .cart-item-qty { grid-area: qty; }
    .cart-item-total { grid-area: total; text-align: right; }
  }
</style>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
