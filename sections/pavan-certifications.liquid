{% comment %}
  Section 8: Quality & Certifications Section
  Incorporates the official "TESTED TO PERFECTION" Certificate of Analysis image asset
{% endcomment %}

<div class="sec-cream sec-padding" id="PavanCertificationsSection">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="eyebrow">{{ section.settings.subheading | escape }}</span>
      <h2 class="sec-title">{{ section.settings.heading | escape }}</h2>
      <p class="sec-desc">{{ section.settings.description | escape }}</p>
    </div>

    <div class="pavan-grid-2">
      <!-- Official Certificate of Analysis Image Asset -->
      <div class="real-banner-box">
        <img 
          src="{{ 'pavan-trusted-quality.png' | asset_url }}" 
          alt="Pavan Steamed Puttu Podi - Trusted Quality Certifications Banner" 
          width="800"
          height="533"
          loading="lazy"
          onclick="openPavanLightbox('{{ 'pavan-trusted-quality.png' | asset_url }}', 'Pavan Steamed Puttu Podi - Trusted Quality Certifications')">
        <p style="font-size: 13px; color: var(--text-light); margin-top: 10px; margin-bottom: 0;">Tap certificate banner to enlarge lab test standards & FSSAI / ISO certification.</p>
      </div>

      <!-- Lab Test Findings & Standards Summary -->
      <div>
        <h3 style="font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--text-main); margin: 0 0 14px;">Verified Lab Test Results</h3>
        <p style="font-size: 15px; color: var(--text-muted); line-height: 1.6; margin-bottom: 20px;">Our puttu podi is tested by certified quality executives for purity, ash content, and particle fineness before leaving the plant.</p>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div style="background: white; border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-main);">Moisture Content (%)</span>
            <span style="font-weight: 700; font-size: 13px; color: var(--secondary); background: var(--secondary-light); padding: 4px 10px; border-radius: 20px;">7.52% (NMT 14.0%)</span>
          </div>

          <div style="background: white; border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-main);">Fineness (300 micron sieve)</span>
            <span style="font-weight: 700; font-size: 13px; color: var(--secondary); background: var(--secondary-light); padding: 4px 10px; border-radius: 20px;">98% Uniformity</span>
          </div>

          <div style="background: white; border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-main);">Total Protein Content (%)</span>
            <span style="font-weight: 700; font-size: 13px; color: var(--secondary); background: var(--secondary-light); padding: 4px 10px; border-radius: 20px;">6.2% Pure Protein</span>
          </div>

          <div style="background: white; border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; gap: 8px;">
            <span style="font-weight: 600; font-size: 14px; color: var(--text-main);">FSSAI & AGMARK Status</span>
            <span style="font-weight: 700; font-size: 13px; color: var(--primary); background: var(--primary-light); padding: 4px 10px; border-radius: 20px;">100% Compliant</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quality & Certifications",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "LAB TESTED & CERTIFIED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tested to Perfection" },
    { "type": "text", "id": "description", "label": "Description", "default": "Full transparency with published Certificate of Analysis lab reports for every production batch." }
  ],
  "presets": [
    { "name": "Quality & Certifications" }
  ]
}
{% endschema %}
