{% doc %}
  Renders global CSS custom properties based on theme settings.
{% enddoc %}

{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% assign min_margin = settings.min_page_margin %}
  {% if min_margin == blank %}
    {% assign min_margin = 16 %}
  {% endif %}

  {% assign page_w = settings.max_page_width %}
  {% if page_w == blank %}
    {% assign page_w = '1200px' %}
  {% endif %}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family | default: "'Inter', sans-serif" }}, {{ settings.type_primary_font.fallback_families | default: "sans-serif" }};
    --font-primary--style: {{ settings.type_primary_font.style | default: 'normal' }};
    --font-primary--weight: {{ settings.type_primary_font.weight | default: 400 }};
    --page-width: {{ page_w }};
    --page-margin: {{ min_margin }}px;
    --color-background: {{ settings.background_color | default: '#ffffff' }};
    --color-foreground: {{ settings.foreground_color | default: '#18181b' }};
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;
  }
{% endstyle %}
