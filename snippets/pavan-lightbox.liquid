{% doc %}
  Renders an image modal lightbox for enlarging certificates, recipe guides, and product infographics.
{% enddoc %}

<div id="PavanLightboxModal" class="pavan-lightbox-modal" role="dialog" aria-modal="true" aria-label="Image Lightbox" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.85); align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <button type="button" onclick="closePavanLightbox()" aria-label="Close Lightbox" style="position: absolute; top: 20px; right: 20px; background: white; border: none; border-radius: 50%; width: 40px; height: 40px; font-size: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: bold; z-index: 10000;">✕</button>
  <div style="max-width: 90vw; max-height: 90vh; text-align: center; overflow: auto; padding: 20px;">
    <img id="PavanLightboxImg" src="{{ 'pavan-trusted-quality.png' | asset_url }}" alt="Enlarged infographic" width="800" height="800" style="max-width: 100%; max-height: 85vh; object-fit: contain; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
    <p id="PavanLightboxCaption" style="color: white; margin-top: 12px; font-size: 14px; font-weight: 500;"></p>
  </div>
</div>

<script>
  function openPavanLightbox(src, caption) {
    const modal = document.getElementById('PavanLightboxModal');
    const modalImg = document.getElementById('PavanLightboxImg');
    const modalCap = document.getElementById('PavanLightboxCaption');
    if (modal && modalImg) {
      modalImg.src = src;
      if (modalCap) modalCap.textContent = caption || '';
      modal.style.display = 'flex';
    }
  }

  function closePavanLightbox() {
    const modal = document.getElementById('PavanLightboxModal');
    if (modal) modal.style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('PavanLightboxModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closePavanLightbox();
      });
    }
  });
</script>
