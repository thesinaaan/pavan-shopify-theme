{% doc %}
  Renders the 4-item trust badges row for product purity, licensing, fast shipping, and ISO certification.
{% enddoc %}

<div class="pavan-trust-features-row">
  <div class="pavan-trust-item">
    <span class="pavan-trust-icon">🌾</span>
    <span class="pavan-trust-text">100% Natural</span>
  </div>
  <div class="pavan-trust-item">
    <span class="pavan-trust-icon">📜</span>
    <span class="pavan-trust-text">FSSAI Regd.</span>
  </div>
  <div class="pavan-trust-item">
    <span class="pavan-trust-icon">🚚</span>
    <span class="pavan-trust-text">Fast Express</span>
  </div>
  <div class="pavan-trust-item">
    <span class="pavan-trust-icon">🏆</span>
    <span class="pavan-trust-text">ISO Certified</span>
  </div>
</div>
