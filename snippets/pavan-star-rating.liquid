{% doc %}
  Renders the Pavan star rating component with review count meta.
{% enddoc %}

<div class="pavan-star-rating" style="display: flex; align-items: center; gap: 6px;">
  <div class="stars" style="color: #f59e0b; display: flex; gap: 2px; font-size: 16px;">
    <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
  </div>
  <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">4.9</span>
  <span style="font-size: 13px; color: var(--text-light);">(486 reviews)</span>
</div>
