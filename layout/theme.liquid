<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }} - {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'pavan-product.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'pavan-product.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <header class="site-header" style="background: white; border-bottom: 1px solid #ececec; padding: 12px 20px;">
      <div class="page-width" style="display: flex; align-items: center; justify-content: space-between; max-width: 1240px; margin: 0 auto;">
        <a href="{{ routes.root_url }}" class="logo-link">
          <img src="{{ 'pavan-logo.png' | asset_url }}" alt="{{ shop.name }}" width="160" height="42" style="height: 42px; width: auto;">
        </a>
        <div class="header-actions">
          <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Shopping Cart" style="position: relative; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; color: #1F2A24;">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span class="cart-badge" style="position: absolute; top: 2px; right: 2px; background: #D96B27; color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center;">{{ cart.item_count | default: 0 }}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% render 'pavan-lightbox' %}

    <footer class="site-footer" style="background: #1f2937; color: white; padding: 32px 20px; margin-top: 60px; text-align: center;">
      <div class="page-width">
        <p style="margin: 0; font-size: 14px; opacity: 0.8;">© {{ 'now' | date: "%Y" }} Pavan Agro Foods. All Rights Reserved. Crafted with Kerala Heritage.</p>
      </div>
    </footer>
  </body>
</html>
