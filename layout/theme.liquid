<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }} - {{ shop.name }}</title>
    {{ content_for_header }}
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag }}
    {{ 'pavan-product.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'pavan-product.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-container">
        <a href="{{ routes.root_url }}" class="logo-link" style="display: flex; align-items: center;">
          <img src="{{ 'pavan-logo.png' | asset_url }}" alt="{{ shop.name }}" width="140" height="40" style="height: 36px; width: auto; object-fit: contain;">
        </a>
        <div class="header-actions" style="display: flex; align-items: center;">
          <a href="{{ routes.cart_url }}" class="icon-btn" aria-label="Shopping Cart" style="position: relative; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: #18181b; text-decoration: none;">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span class="cart-badge" style="position: absolute; top: 0px; right: 0px; background: #D96B27; color: white; border-radius: 50%; width: 18px; height: 18px; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 4px rgba(217,107,39,0.4);">{{ cart.item_count | default: 0 }}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% render 'pavan-lightbox' %}

    <footer class="site-footer" style="background: #18181b; color: #a1a1aa; padding: 48px 20px 32px; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 60px;">
      <div class="page-width" style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center;">
        <img src="{{ 'pavan-logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" height="36" style="height: 32px; width: auto; object-fit: contain; filter: brightness(0) invert(1);">
        <p style="margin: 0; font-size: 14px; color: #a1a1aa;">Premium Authentic Kerala Food Products • Aluva, Kerala</p>
        <div style="display: flex; gap: 24px; font-size: 13px; font-weight: 500; margin-top: 8px; flex-wrap: wrap; justify-content: center;">
          <a href="#" style="color: #d4d4d8; text-decoration: none;">Privacy Policy</a>
          <a href="#" style="color: #d4d4d8; text-decoration: none;">Terms of Service</a>
          <a href="#" style="color: #d4d4d8; text-decoration: none;">Shipping Policy</a>
          <a href="#" style="color: #d4d4d8; text-decoration: none;">Contact Us</a>
        </div>
        <div style="border-top: 1px solid rgba(255,255,255,0.1); width: 100%; padding-top: 24px; font-size: 13px; color: #71717a;">
          © {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved. Crafted with Kerala Heritage.
        </div>
      </div>
    </footer>
  </body>
</html>
